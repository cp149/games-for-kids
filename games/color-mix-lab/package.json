{
  "name": "color-mix-lab",
  "version": "1.0.0",
  "description": "Color mixing educational game for children ages 5-8",
  "scripts": {
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/i18n/**"
    ],
    "moduleDirectories": [
      "node_modules",
      "js"
    ]
  }
}
