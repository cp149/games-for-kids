{
  "name": "color-mix-lab-tests",
  "version": "1.0.0",
  "description": "Unit tests for Color Mix Lab game",
  "scripts": {
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/*.test.js"],
    "collectCoverageFrom": [
      "../js/**/*.js"
    ]
  }
}
