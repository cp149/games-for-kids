{
  "name": "path-race-tests",
  "version": "1.0.0",
  "description": "Unit tests for Path Race game algorithms",
  "scripts": {
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/*.test.js"],
    "collectCoverageFrom": [
      "../js/classes/*.js",
      "../js/utils/*.js",
      "../js/managers/*.js"
    ]
  }
}
